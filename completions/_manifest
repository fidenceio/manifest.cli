#compdef manifest
# Zsh completion for Manifest CLI.
# Install: copy or symlink this file into a directory on $fpath named '_manifest',
# then run `compinit`. Homebrew puts user completions in /opt/homebrew/share/zsh/site-functions/.

_manifest_keys() {
    local -a keys
    if [[ -z "${_MANIFEST_ZSH_KEYS_CACHE:-}" ]]; then
        _MANIFEST_ZSH_KEYS_CACHE="$(manifest config list 2>/dev/null | awk 'NR>2 && $1!="" {print $1}' | sort -u)"
    fi
    keys=(${(f)_MANIFEST_ZSH_KEYS_CACHE})
    _describe 'config keys' keys
}

_manifest() {
    local -a top_cmds
    top_cmds=(
        'config:Setup wizard / show configuration'
        'init:Set up a repo or fleet (--connect for remotes)'
        'plan:Generate an adoption plan'
        'reconcile:Validate and apply an adoption plan'
        'status:Read-only snapshot'
        'recipe:Inspect workflow recipes'
        'discover:Discover resources without writing changes'
        'update:Update fleet membership'
        'add:Add a resource to Manifest-managed configuration'
        'validate:Validate fleet configuration'
        'docs:Regenerate documentation for a repo or fleet'
        'topics:Add GitHub topics from each repo name'
        'ship:Publish a release (version + tag + push)'
        'pr:Pull-request operations (gh wrapper)'
        'doctor:Health check'
        'cleanup:Remove Manifest'"'"'s own leftovers (repo, fleet, or this machine)'
        'security:Security audit'
        'env:Generate or check environment-variable files'
        'upgrade:Update Manifest CLI'
        'reinstall:Remove and install Manifest CLI again'
        'uninstall:Remove Manifest CLI'
        'revert:Check out an older version tag'
        'test:Run diagnostic tests (needs Manifest Cloud)'
        'cloud:Manifest Cloud connector (needs Manifest Cloud)'
        'agent:Containerized cloud agent (needs Manifest Cloud)'
        'version:Show CLI version'
        'help:Show help'
    )

    local -a scopes bumps config_subs pr_subs recipe_subs write_layers read_layers
    scopes=(repo fleet)
    bumps=(patch minor major revision)
    config_subs=(show list get set unset describe doctor setup time)
    pr_subs=(create status checks ready merge update queue policy fleet help)
    recipe_subs=(list show explain help)
    # 'fleet' is READ-ONLY (inherited from the fleet root): offered to
    # `config list`, never to set/unset.
    write_layers=(global project local)
    read_layers=(global project local fleet)

    if [[ "${words[2]:-}" == revert && "${words[3]:-}" == repo && "$CURRENT" -ge 4 ]]; then
        local -a tags
        tags=("${(@f)$(git tag --sort=-version:refname 2>/dev/null)}")
        _values 'tag / option' "${tags[@]}" -y --yes --dry-run --help
        return
    fi

    if [[ "${words[2]:-}" == revert && "${words[3]:-}" == fleet && "$CURRENT" -ge 4 ]]; then
        local -a snapshots
        snapshots=("${(@f)$(git log --all -10 --format=%h -- manifest.fleet.snapshot.json 2>/dev/null)}")
        _values 'snapshot / option' "${snapshots[@]}" -y --yes --dry-run --help
        return
    fi

    _arguments -C \
        '1: :->command' \
        '2: :->subcommand' \
        '3: :->arg3' \
        '*::extra:->extra'

    case $state in
        command)
            _describe 'command' top_cmds
            ;;
        subcommand)
            case $words[2] in
                # `status` takes repo|fleet too (manifest-status.sh:7, and
                # manifest-core.sh's _manifest_cli_is_existing_repo_scope_request).
                # All three completion files omitted it identically.
                ship|status)
                    _values 'scope' "${scopes[@]}"
                    ;;
                revert)
                    _values 'scope' repo fleet --help
                    ;;
                init)
                    _values 'scope / option' repo fleet -y --yes --dry-run --depth --name --force --remote --no-connect --create-repo-private --create-repo-public --help
                    ;;
                docs)
                    _values 'docs action' fleet metadata cleanup --help
                    ;;
                # cleanup takes repo|fleet plus `state`, a host-level word that
                # is deliberately not a repo/fleet scope.
                cleanup)
                    _values 'cleanup scope' repo fleet state
                    ;;
                plan|reconcile|discover|update|add|validate|topics)
                    _values 'scope' fleet
                    ;;
                config)
                    _values 'config subcommand' "${config_subs[@]}"
                    ;;
                recipe)
                    _values 'recipe subcommand' "${recipe_subs[@]}"
                    ;;
                env)
                    _values 'env subcommand' generate validate help
                    ;;
                # See completions/manifest.bash: 'cloud' subcommands are
                # declared in-repo; 'agent' has only an argument-ignoring stub,
                # so it deliberately gets no subcommand list.
                cloud)
                    _values 'cloud subcommand' config status generate
                    ;;
                pr)
                    _values 'pr subcommand' "${pr_subs[@]}"
                    ;;
                uninstall)
                    _values 'option' -y --yes --dry-run --force --help
                    ;;
                reinstall)
                    _values 'option' -y --yes --dry-run --help
                    ;;
            esac
            ;;
        arg3)
            case "$words[2] $words[3]" in
                "init repo")
                    _values 'option' -y --yes --force --dry-run --connect --no-connect --remote --create-repo-private --create-repo-public --help
                    ;;
                "init fleet")
                    _values 'option' -y --yes --depth --all-folders --force --dry-run --name --connect --no-connect --parallel --clone-only --pull-only --create-repo-private --create-repo-public --help
                    ;;
                "ship repo")
                    _values 'release type / option' "${bumps[@]}" resume -y --yes --local --dry-run --explain --force-bump -i --interactive
                    ;;
                "ship fleet")
                    _values 'release type / option' "${bumps[@]}" resume manager -y --yes --local --dry-run --explain --force-bump --require-clean
                    ;;
                "topics fleet")
                    _values 'option' -y --yes --dry-run --help
                    ;;
                "plan fleet")
                    _values 'option' -y --yes --dry-run --depth --safety-cap --plan --name --force --help
                    ;;
                "reconcile fleet")
                    _values 'option' -y --yes --dry-run --plan --commit --push --force --adopt-submodules --help
                    ;;
                "pr create")
                    _values 'option' -y --yes --dry-run --draft --title --body --base --labels --reviewers --help
                    ;;
                "pr ready"|"pr merge"|"pr update"|"pr queue")
                    _values 'option' -y --yes --dry-run --method --force --auto --squash --merge --rebase --help
                    ;;
                "pr fleet")
                    _values 'fleet PR subcommand / option' create status checks ready queue help -y --yes --dry-run --method --force --help
                    ;;
                "config get"|"config describe"|"config unset"|"config set")
                    _manifest_keys
                    ;;
                "config list")
                    _values 'option' --layer
                    ;;
            esac
            ;;
        extra)
            if [[ $words[$((CURRENT-1))] == "--layer" ]]; then
                if [[ $words[2] == "config" && $words[3] == "list" ]]; then
                    _values 'layer' "${read_layers[@]}"
                else
                    _values 'layer' "${write_layers[@]}"
                fi
            else
                _values 'option' --help -y --yes --local --dry-run --explain --layer --fix --json
            fi
            ;;
    esac
}

_manifest "$@"
