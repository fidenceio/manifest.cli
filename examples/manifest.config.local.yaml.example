# =============================================================================
# Manifest CLI — Local Overrides (Personal / Per-Machine)
# =============================================================================
# This file is git-ignored. It is NOT committed or shared.
# Use it for settings that differ per developer or per machine.
#
# Setup:
#   cp examples/manifest.config.local.yaml.example manifest.config.local.yaml
#
# Only include keys you want to override — everything else comes from
# manifest.config.yaml (project), the inherited fleet layer when this repo sits
# inside a fleet, the user global config, or code defaults.
#
# Full layer model: docs/USER_GUIDE.md#configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Debugging and Development
# -----------------------------------------------------------------------------
# debug:
#   enabled: true
#   verbose: true
#   log_level: "DEBUG"
#   interactive: true

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
# Override the project/global timezone for your machine.
# Uses IANA names: America/New_York, Europe/London, Asia/Tokyo, etc.
#
# time:
#   timezone: "America/New_York"

# -----------------------------------------------------------------------------
# GitHub (per-developer overrides)
# -----------------------------------------------------------------------------
# owner — the namespace new repositories are created under
# (`manifest init|prep ... --create-repo-*`). Left unset it is read from this
# repo's own `origin` remote, and only a repo with no origin falls back to
# whoever `gh` is authenticated as. Set it here when neither answer is right —
# e.g. your gh login is personal but you ship to an organization. A value set
# here wins over origin, and the disagreement is reported rather than silent.
# Accepts one GitHub user or organization name — no owner/name slug.
#
# github:
#   owner: "acme-corp"

# -----------------------------------------------------------------------------
# Git (per-developer overrides)
# -----------------------------------------------------------------------------
# git:
#   default_branch: "develop"

# -----------------------------------------------------------------------------
# Project Metadata
# -----------------------------------------------------------------------------
# project:
#   name: "My Awesome Project"
#   description: "A revolutionary tool for developers"
#   organization: "Acme Corp"
#   team: "Development Team"
