#!/usr/bin/env bats
#
# examples/env-k8s-render.sh — the reference renderer an adopter copies when
# Manifest stops writing k8s/env (TRACKER §104).
#
# Its acceptance test is the one the removal was conditioned on: the files it
# renders from `manifest env export` differ from the files Manifest itself
# wrote only in their comment lines. tests/fixtures/env_k8s_reference/golden
# holds what the last release that rendered them wrote for the fixture spec.
#
# The script is an example, owned by whoever copies it — but it ships in the
# release, and an example that does not do what it says is a defect of ours.

load 'helpers/setup'

setup() {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    SCRATCH="$(mk_scratch)"
    HOME="$SCRATCH/home"
    mkdir -p "$HOME"
    export HOME
    FIXTURE="$TEST_REPO_ROOT/tests/fixtures/env_k8s_reference"
    RENDER="$TEST_REPO_ROOT/examples/env-k8s-render.sh"
    # The folder is named as the golden files' checkout was, and has no origin,
    # so the export's identity is the name those files carry.
    PROJ="$SCRATCH/acme.widget"
    mkdir -p "$PROJ"
    git -C "$PROJ" init -q -b main
    cp "$FIXTURE/service.spec.yaml" "$PROJ/service.spec.yaml"
    unset MANIFEST_CLI_PROJECT_ROOT
    ( cd "$PROJ" && "$TEST_REPO_ROOT/scripts/manifest-cli.sh" env export ) > "$SCRATCH/export.json" 2>/dev/null
    FULL=(--provider external-secrets --store-name platform-store
          --path 'secret/data/{env}/{identity}/{group}' --env-label environment)
}

teardown() {
    cd /tmp
    rm -rf "$SCRATCH"
}

# A file without its comment lines.
body() {
    grep -v '^#' "$1"
}

same_but_for_comments() {
    local golden="$1" rendered="$2"
    [ -f "$rendered" ] || { echo "not rendered: $rendered"; return 1; }
    if [ "$(body "$golden")" != "$(body "$rendered")" ]; then
        echo "differs beyond comments: $rendered"
        diff <(body "$golden") <(body "$rendered") || true
        return 1
    fi
}

@test "positive control: the fixture export is a real document with the fixture's secrets and non-secrets" {
    [ "$(yq e -p=json '.identity' "$SCRATCH/export.json")" = "acme.widget" ]
    [ "$(yq e -p=json '[.env[] | select(.secret == true)] | length' "$SCRATCH/export.json")" = "2" ]
    [ "$(yq e -p=json '[.env[] | select(.secret == false)] | length' "$SCRATCH/export.json")" = "4" ]
    # And the golden files are Manifest's own output, header and all.
    [ "$(head -c 27 "$FIXTURE/golden/full/configmap.yaml")" = "# Generated by Manifest CLI" ]
}

@test "with a store configured: all four files match what Manifest wrote, comment lines aside" {
    run "$RENDER" --out "$SCRATCH/k8s/env" "${FULL[@]}" "$SCRATCH/export.json"
    [ "$status" -eq 0 ]
    local f
    for f in configmap.yaml external-secret.yaml kustomization.yaml component/kustomization.yaml; do
        same_but_for_comments "$FIXTURE/golden/full/$f" "$SCRATCH/k8s/env/$f"
    done
    [ "$(find "$SCRATCH/k8s/env" -type f | wc -l | tr -d ' ')" -eq 4 ]
    # Each carries the script's header, not Manifest's: they are the adopter's.
    for f in configmap.yaml external-secret.yaml kustomization.yaml component/kustomization.yaml; do
        [ "$(head -n 1 "$SCRATCH/k8s/env/$f")" = '# Generated by env-k8s-render.sh from `manifest env export`.' ]
    done
}

@test "with --provider none (the default), from stdin: the two files match, and no secret is rendered anywhere" {
    run bash -c '"$1" --out "$2" < "$3"' _ "$RENDER" "$SCRATCH/k8s/env" "$SCRATCH/export.json"
    [ "$status" -eq 0 ]
    same_but_for_comments "$FIXTURE/golden/none/configmap.yaml" "$SCRATCH/k8s/env/configmap.yaml"
    same_but_for_comments "$FIXTURE/golden/none/kustomization.yaml" "$SCRATCH/k8s/env/kustomization.yaml"
    [ "$(find "$SCRATCH/k8s/env" -type f | wc -l | tr -d ' ')" -eq 2 ]
    [[ "$output" == *"2 secret variable(s) are not rendered"* ]]
    refute grep -rq 'DATABASE_URL\|SIGNING_KEY' "$SCRATCH/k8s/env"
}

@test "the mutation the comparison must catch: one changed value in a rendered file fails it" {
    run "$RENDER" --out "$SCRATCH/k8s/env" "${FULL[@]}" "$SCRATCH/export.json"
    [ "$status" -eq 0 ]
    sed 's/platform-store/other-store/' "$SCRATCH/k8s/env/external-secret.yaml" > "$SCRATCH/mutated.yaml"
    run same_but_for_comments "$FIXTURE/golden/full/external-secret.yaml" "$SCRATCH/mutated.yaml"
    [ "$status" -ne 0 ]
}

@test "it takes over a file Manifest generated, leaves a hand-written one alone, and --force is how to say otherwise" {
    mkdir -p "$SCRATCH/k8s/env"
    cp "$FIXTURE/golden/full/configmap.yaml" "$SCRATCH/k8s/env/configmap.yaml"     # Manifest's header
    printf 'apiVersion: v1\nkind: Secret\n' > "$SCRATCH/k8s/env/external-secret.yaml"

    run "$RENDER" --out "$SCRATCH/k8s/env" "${FULL[@]}" "$SCRATCH/export.json"
    [ "$status" -eq 0 ]
    [ "$(head -n 1 "$SCRATCH/k8s/env/configmap.yaml")" = '# Generated by env-k8s-render.sh from `manifest env export`.' ]
    [[ "$output" == *"hand-authored, left untouched: $SCRATCH/k8s/env/external-secret.yaml"* ]]
    [ "$(cat "$SCRATCH/k8s/env/external-secret.yaml")" = "$(printf 'apiVersion: v1\nkind: Secret')" ]

    run "$RENDER" --out "$SCRATCH/k8s/env" --force "${FULL[@]}" "$SCRATCH/export.json"
    [ "$status" -eq 0 ]
    [ "$(yq e '.kind' "$SCRATCH/k8s/env/external-secret.yaml")" = "ExternalSecret" ]
}

@test "--check writes nothing: exit 0 when current, exit 1 naming the file when the spec has moved on" {
    run "$RENDER" --out "$SCRATCH/k8s/env" --check "${FULL[@]}" "$SCRATCH/export.json"
    [ "$status" -eq 1 ]
    [ ! -e "$SCRATCH/k8s/env" ]

    run "$RENDER" --out "$SCRATCH/k8s/env" "${FULL[@]}" "$SCRATCH/export.json"
    [ "$status" -eq 0 ]
    run "$RENDER" --out "$SCRATCH/k8s/env" --check "${FULL[@]}" "$SCRATCH/export.json"
    [ "$status" -eq 0 ]

    yq e -i '.env[0].default = "debug"' "$PROJ/service.spec.yaml"
    ( cd "$PROJ" && "$TEST_REPO_ROOT/scripts/manifest-cli.sh" env export ) > "$SCRATCH/export2.json" 2>/dev/null
    run "$RENDER" --out "$SCRATCH/k8s/env" --check "${FULL[@]}" "$SCRATCH/export2.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"out of date:  $SCRATCH/k8s/env/configmap.yaml"* ]]
    grep -q 'ACME_WIDGET_LOG_LEVEL: "info"' "$SCRATCH/k8s/env/configmap.yaml"      # not written
}

@test "settings it cannot render from are refused before anything is written, each by name" {
    run "$RENDER" --out "$SCRATCH/k8s/env" --provider external-secrets "$SCRATCH/export.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"--store-name is not set"* ]]
    [[ "$output" == *"--path is not set"* ]]
    [[ "$output" == *"Nothing was written."* ]]
    [ ! -e "$SCRATCH/k8s/env" ]

    run "$RENDER" --out "$SCRATCH/k8s/env" --provider external-secrets --store-name platform-store \
        --path 'kv/prod-{env}/{identity}' --env-label environment "$SCRATCH/export.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"{env} must be a whole path segment"* ]]

    run "$RENDER" --out "$SCRATCH/k8s/env" --provider external-secrets --store-name platform-store \
        --path 'kv/{env}/{team}' --env-label environment "$SCRATCH/export.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"unknown token {team}"* ]]

    run "$RENDER" --out "$SCRATCH/k8s/env" --provider external-secrets --store-name platform-store \
        --path 'kv/{env}/{identity}' "$SCRATCH/export.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"--env-label is not set"* ]]

    run "$RENDER" --out "$SCRATCH/k8s/env" --provider sealed "$SCRATCH/export.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"--provider 'sealed' is not recognised"* ]]
    [ ! -e "$SCRATCH/k8s/env" ]
}

@test "a path without {env} renders no Component; --identity renames every object" {
    run "$RENDER" --out "$SCRATCH/k8s/env" --identity legacy-folder --provider external-secrets \
        --store-name platform-store --path 'kv/{identity}/{group}' "$SCRATCH/export.json"
    [ "$status" -eq 0 ]
    [ ! -e "$SCRATCH/k8s/env/component" ]
    [ "$(yq e '.metadata.name' "$SCRATCH/k8s/env/configmap.yaml")" = "legacy-folder-env" ]
    [ "$(yq e '.metadata.name' "$SCRATCH/k8s/env/external-secret.yaml")" = "legacy-folder-env" ]
    [ "$(yq e '.spec.data[0].remoteRef.key' "$SCRATCH/k8s/env/external-secret.yaml")" = "kv/legacy-folder/database" ]
}

@test "a default with a quote or a backslash renders YAML that parses back to the same value; one that spans lines is refused" {
    cat > "$PROJ/service.spec.yaml" <<'YAML'
env:
  - name: ACME_WIDGET_GREETING
    default: 'say "hi" then C:\temp'
YAML
    ( cd "$PROJ" && "$TEST_REPO_ROOT/scripts/manifest-cli.sh" env export ) > "$SCRATCH/export3.json" 2>/dev/null
    run "$RENDER" --out "$SCRATCH/k8s/env" "$SCRATCH/export3.json"
    [ "$status" -eq 0 ]
    [ "$(yq e '.data.ACME_WIDGET_GREETING' "$SCRATCH/k8s/env/configmap.yaml")" = 'say "hi" then C:\temp' ]

    cat > "$PROJ/service.spec.yaml" <<'YAML'
env:
  - name: ACME_WIDGET_BANNER
    default: "first\nsecond"
YAML
    ( cd "$PROJ" && "$TEST_REPO_ROOT/scripts/manifest-cli.sh" env export ) > "$SCRATCH/export4.json" 2>/dev/null
    rm -rf "$SCRATCH/k8s"
    run "$RENDER" --out "$SCRATCH/k8s/env" "$SCRATCH/export4.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"ACME_WIDGET_BANNER: its default spans more than one line"* ]]
    [ ! -e "$SCRATCH/k8s/env/configmap.yaml" ]
}

@test "a default of false is rendered as \"false\", where Manifest's own renderer wrote an empty string" {
    # One of the two documented differences from what Manifest wrote (the other
    # is the quoting above): Manifest read `default: false` as unset.
    cat > "$PROJ/service.spec.yaml" <<'YAML'
env:
  - name: ACME_WIDGET_FEATURE
    default: false
  - name: ACME_WIDGET_UNSET
YAML
    ( cd "$PROJ" && "$TEST_REPO_ROOT/scripts/manifest-cli.sh" env export ) > "$SCRATCH/export5.json" 2>/dev/null
    run "$RENDER" --out "$SCRATCH/k8s/env" "$SCRATCH/export5.json"
    [ "$status" -eq 0 ]
    grep -qx '  ACME_WIDGET_FEATURE: "false"' "$SCRATCH/k8s/env/configmap.yaml"
    grep -qx '  ACME_WIDGET_UNSET: ""' "$SCRATCH/k8s/env/configmap.yaml"
}

@test "a value that would break or extend the YAML is refused before anything is written: identity, store kind, a name, a group" {
    run "$RENDER" --out "$SCRATCH/k8s/env" --identity 'a: b' "$SCRATCH/export.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"identity 'a: b' must be a plain name"* ]]

    run "$RENDER" --out "$SCRATCH/k8s/env" --store-kind $'Kind\n  injected: 1' "${FULL[@]}" "$SCRATCH/export.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"--store-kind"* ]]

    printf '%s' '{"schema":1,"identity":"x","env":[{"name":"- C","description":"","required":false,"default":"v","secret":false,"group":"app","public":false,"framework_name":null}]}' > "$SCRATCH/name.json"
    run "$RENDER" --out "$SCRATCH/k8s/env" "$SCRATCH/name.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"'- C' is not a plain variable name"* ]]

    printf '%s' '{"schema":1,"identity":"x","env":[{"name":"C","description":"","required":false,"default":null,"secret":true,"group":"a\"b","public":false,"framework_name":null}]}' > "$SCRATCH/group.json"
    run "$RENDER" --out "$SCRATCH/k8s/env" --provider external-secrets --store-name s --path 'kv/{group}' "$SCRATCH/group.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"would contain a quote, a backslash or whitespace"* ]]

    [ ! -e "$SCRATCH/k8s/env" ]

    # Positive control: a name with a dot and a dash is a legal key, and
    # Manifest's own renderer wrote such names. It is rendered, not refused.
    printf '%s' '{"schema":1,"identity":"x","env":[{"name":"acme.http-port","description":"","required":false,"default":"8080","secret":false,"group":"app","public":false,"framework_name":null}]}' > "$SCRATCH/dotted.json"
    run "$RENDER" --out "$SCRATCH/k8s/env" "$SCRATCH/dotted.json"
    [ "$status" -eq 0 ]
    [ "$(yq e '.data["acme.http-port"]' "$SCRATCH/k8s/env/configmap.yaml")" = "8080" ]
}

@test "input that is not a schema 1 export is refused: empty, not JSON, another schema" {
    : > "$SCRATCH/empty.json"
    run "$RENDER" --out "$SCRATCH/k8s/env" "$SCRATCH/empty.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"the export is empty"* ]]

    printf '{"schema": 2, "identity": "x", "env": []}\n' > "$SCRATCH/two.json"
    run "$RENDER" --out "$SCRATCH/k8s/env" "$SCRATCH/two.json"
    [ "$status" -eq 1 ]
    [[ "$output" == *"not a schema 1 export"* ]]
    [ ! -e "$SCRATCH/k8s/env" ]
}

# --- the rendered files build ---------------------------------------------------------------

_kustomize_build() {
    if command -v kustomize >/dev/null 2>&1; then
        kustomize build "$1"
    else
        kubectl kustomize "$1"
    fi
}

@test "kustomize fills {env} from the label with the rendered Component, and the layering its header prescribes is the one that works" {
    command -v kustomize >/dev/null 2>&1 || command -v kubectl >/dev/null 2>&1 || skip "neither kustomize nor kubectl available"
    run "$RENDER" --out "$PROJ/k8s/env" "${FULL[@]}" "$SCRATCH/export.json"
    [ "$status" -eq 0 ]

    # The recipe the Component's own header prescribes: the label one layer
    # down, then that layer and the Component together. The directory is a
    # buildable base (kustomize refuses a FILE outside the referencing
    # directory, so the layer references the directory).
    mkdir -p "$PROJ/k8s/overlays/prod/env"
    cat > "$PROJ/k8s/overlays/prod/env/kustomization.yaml" <<'YAML'
resources: [ ../../../env ]
labels: [ { pairs: { environment: prod } } ]
YAML
    cat > "$PROJ/k8s/overlays/prod/kustomization.yaml" <<'YAML'
resources: [ env ]
components: [ ../../env/component ]
YAML
    run _kustomize_build "$PROJ/k8s/overlays/prod"
    [ "$status" -eq 0 ]
    [[ "$output" == *'key: secret/data/prod/acme.widget/database'* ]]
    [[ "$output" == *'key: secret/data/prod/acme.widget/app'* ]]
    [[ "$output" != *'{env}'* ]]

    # Negative control, and the reason the recipe has two layers: the label
    # beside `components:` in ONE kustomization is applied after the Component
    # ran, so the replacement finds no source and the build fails.
    mkdir -p "$PROJ/k8s/overlays/flat"
    cat > "$PROJ/k8s/overlays/flat/kustomization.yaml" <<'YAML'
resources: [ ../../env ]
components: [ ../../env/component ]
labels: [ { pairs: { environment: prod } } ]
YAML
    run _kustomize_build "$PROJ/k8s/overlays/flat"
    [ "$status" -ne 0 ]
    [[ "$output" == *'metadata.labels.environment'* ]]
}
