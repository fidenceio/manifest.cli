#!/usr/bin/env bats
# bats file_tags=smoke
#
# Manifest renders no deployment file and reads no secret-store setting
# (TRACKER §104).
#
# `manifest env generate` used to write a ConfigMap, an ExternalSecret, a
# kustomization and a kustomize Component under k8s/env, steered by eight
# env.secrets.* keys, and refused to run when secrets were declared with no
# store configured. How variables reach a cluster is the platform's design, so
# all of that is gone:
#
#   no writer      nothing under k8s/ is created, with or without a k8s/ folder
#   no gate        secrets declared with nothing configured → generate succeeds
#   no reader      a leftover env.secrets setting changes no output
#   retired keys   the family is out of the schema and `config doctor` names it
#   said once      a repo holding a file Manifest generated there, or a leftover
#                  setting, is told so on stderr by `init repo` (plan, -y,
#                  --check) — once per command, exit status unchanged — and a
#                  repo holding neither never is
#   no platform    to a repo that never used the rendering, nothing the env
#                  commands print names a platform, a store or a vendor
#
# The commands were `manifest env generate|validate|export` until TRACKER
# §127 moved them to `init repo [--check]` and `status repo --env [--json]`.
#
# Tagged smoke: "Manifest does not touch the platform's files" is a safety
# contract, and so is not handing a consumer a secret.

load 'helpers/setup'

_FORMER_VARS=(MANIFEST_CLI_ENV_SECRETS_PROVIDER MANIFEST_CLI_ENV_SECRETS_STORE_KIND
    MANIFEST_CLI_ENV_SECRETS_STORE_NAME MANIFEST_CLI_ENV_SECRETS_API_VERSION
    MANIFEST_CLI_ENV_SECRETS_PATH MANIFEST_CLI_ENV_SECRETS_PROPERTY
    MANIFEST_CLI_ENV_SECRETS_REFRESH_INTERVAL MANIFEST_CLI_ENV_SECRETS_ENV_LABEL)

_clear_former_vars() {
    local v
    for v in "${_FORMER_VARS[@]}"; do unset "$v"; done
}

setup() {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    load_modules "system/manifest-env-naming.sh" "system/manifest-security.sh" \
        "core/manifest-init.sh" "core/manifest-env.sh"
    SCRATCH="$(mk_scratch)"
    HOME="$SCRATCH/home"
    mkdir -p "$HOME"
    export HOME
    # The physical path: the CLI resolves the project root, and on macOS a
    # temp directory is reached through a symlink (/var → /private/var).
    mkdir -p "$SCRATCH/acme.svc.billing"
    PROJ="$(cd "$SCRATCH/acme.svc.billing" && pwd -P)"
    git -C "$PROJ" init -q -b main
    printf '.env\n.env.*\n!.env.example\n!.env.template\n' > "$PROJ/.gitignore"
    export MANIFEST_CLI_PROJECT_ROOT="$PROJ"
    _clear_former_vars
    cd "$PROJ"
}

teardown() {
    cd /tmp
    rm -rf "$SCRATCH"
    unset MANIFEST_CLI_PROJECT_ROOT
    _clear_former_vars
}

write_spec() {
    cat > "${1:-$PROJ}/app.spec.yaml" <<'YAML'
name: acme.svc.billing
env:
  - name: ACME_SVC_BILLING_LOG_LEVEL
    default: info
  - name: ACME_SVC_BILLING_API_TOKEN
    required: true
    secret: true
    group: db
YAML
}

# Run the tree's own entrypoint in a repo, keeping stdout and stderr apart:
# the notice is a stderr contract, and bats' `run` merges the two.
#   cli_in <dir> <args...>   → CLI_RC, $SCRATCH/out, $SCRATCH/err
cli_in() {
    local dir="$1"
    shift
    CLI_RC=0
    ( cd "$dir" && env -u MANIFEST_CLI_PROJECT_ROOT HOME="$HOME" \
        "$TEST_REPO_ROOT/scripts/manifest-cli.sh" "$@" ) > "$SCRATCH/out" 2> "$SCRATCH/err" || CLI_RC=$?
}
cli() { cli_in "$PROJ" "$@"; }

_NOTICE="Note: Manifest no longer writes or checks deployment files under k8s/env."

notice_count() {
    grep -cF -- "$_NOTICE" "$SCRATCH/err" || true
}

# A file as an earlier Manifest generated it.
former_file() {
    mkdir -p "$(dirname "$PROJ/$1")"
    printf '# Generated by Manifest CLI from app.spec.yaml `env:`.\nkind: Whatever\n' > "$PROJ/$1"
}

# --- no gate, no writer ------------------------------------------------------------------------

@test "secrets declared and nothing configured: preview, --check and -y all succeed, and only .env.example is written" {
    # This spec used to exit 1 in every mode until env.secrets was set.
    write_spec
    mkdir -p "$PROJ/k8s"

    run manifest_env_generate
    [ "$status" -eq 0 ]
    [[ "$output" == *"would create: .env.example"* ]]
    run manifest_env_generate --check
    [ "$status" -eq 1 ]                       # stale, not refused
    [[ "$output" == *"env drift: 1 artifact(s) stale"* ]]

    run manifest_env_generate -y
    [ "$status" -eq 0 ]
    grep -qx "# secret — set from the platform's secret store; never a literal value in any .env" "$PROJ/.env.example"
    grep -qx '# ACME_SVC_BILLING_API_TOKEN=' "$PROJ/.env.example"
    [ -z "$(find "$PROJ/k8s" -mindepth 1)" ]
    run manifest_env_generate --check
    [ "$status" -eq 0 ]
}

@test "no setting is read: with every former setting exported, .env.example is byte for byte what it is with none" {
    write_spec
    run manifest_env_generate -y
    [ "$status" -eq 0 ]
    local plain
    plain="$(cat "$PROJ/.env.example")"

    export MANIFEST_CLI_ENV_SECRETS_PROVIDER=external-secrets
    export MANIFEST_CLI_ENV_SECRETS_STORE_KIND=SecretStore
    export MANIFEST_CLI_ENV_SECRETS_STORE_NAME=team-store
    export MANIFEST_CLI_ENV_SECRETS_API_VERSION=example.test/v9
    export MANIFEST_CLI_ENV_SECRETS_PATH='kv/{env}/{identity}/{group}'
    export MANIFEST_CLI_ENV_SECRETS_PROPERTY='{group}-{name}'
    export MANIFEST_CLI_ENV_SECRETS_REFRESH_INTERVAL=5m
    export MANIFEST_CLI_ENV_SECRETS_ENV_LABEL=stage
    mkdir -p "$PROJ/k8s"
    rm -f "$PROJ/.env.example"
    run manifest_env_generate -y
    [ "$status" -eq 0 ]
    [ "$(cat "$PROJ/.env.example")" = "$plain" ]
    refute grep -q 'team-store\|kv/\|SecretStore' "$PROJ/.env.example"
    [ -z "$(find "$PROJ/k8s" -mindepth 1)" ]
}

# --- the schema ----------------------------------------------------------------------------------

@test "the env.secrets family is out of the schema and in the retired list; no default exports one of its variables" {
    # shellcheck disable=SC1091
    source "$TEST_REPO_ROOT/modules/core/manifest-yaml.sh"
    # shellcheck disable=SC1091
    source "$TEST_REPO_ROOT/modules/core/manifest-config.sh"

    local key
    for key in provider store.kind store.name api_version path property refresh_interval env_label; do
        [ -z "${_MANIFEST_YAML_TO_ENV[env.secrets.$key]:-}" ] || { echo "still mapped: env.secrets.$key"; false; }
    done
    # Positive control: the map is the real one, and a live env key is in it.
    [ "${_MANIFEST_YAML_TO_ENV[env.prefix]}" = "MANIFEST_CLI_ENV_PREFIX" ]

    local retired found=false
    for retired in "${_MANIFEST_CLI_CONFIG_RETIRED_KEYS[@]}"; do
        [ "$retired" = "env.secrets" ] && found=true
    done
    [ "$found" = "true" ]

    refute grep -q 'MANIFEST_CLI_ENV_SECRETS_' "$TEST_REPO_ROOT/modules/core/manifest-config.sh"
    refute grep -rq '_manifest_env_secrets_' "$TEST_REPO_ROOT/modules"
}

@test "config doctor names a leftover env.secrets, and --fix -y removes the family whole and nothing else" {
    cat > "$PROJ/manifest.config.yaml" <<'YAML'
env:
  prefix: ACME_
  secrets:
    provider: external-secrets
    store:
      name: team-store
    path: "kv/{env}/{identity}"
YAML
    cli config doctor --file "$PROJ/manifest.config.yaml"
    [ "$CLI_RC" -eq 0 ]
    grep -q "OBSOLETE: env.secrets is set but no longer exists; nothing reads it. Safe to delete." "$SCRATCH/out"
    # Its live neighbour is not reported.
    refute grep -q "OBSOLETE: env.prefix" "$SCRATCH/out"
    [ "$(yq e '.env.secrets.store.name' "$PROJ/manifest.config.yaml")" = "team-store" ]   # read-only

    cli config doctor --fix --file "$PROJ/manifest.config.yaml" -y
    [ "$CLI_RC" -eq 0 ]
    grep -q "removed|env.secrets||" "$SCRATCH/out"
    [ "$(yq e '.env.secrets' "$PROJ/manifest.config.yaml")" = "null" ]
    [ "$(yq e '.env.prefix' "$PROJ/manifest.config.yaml")" = "ACME_" ]
}

# --- said once, to the repos it concerns -------------------------------------------------------

@test "files an earlier Manifest generated under k8s/env: the notice lists exactly those, on stderr, once, and changes no exit status" {
    write_spec
    former_file k8s/env/configmap.yaml
    former_file k8s/env/component/kustomization.yaml
    # At a former path but hand-written: never Manifest's, so not listed.
    mkdir -p "$PROJ/k8s/env"
    printf 'apiVersion: v1\nkind: Secret\n' > "$PROJ/k8s/env/external-secret.yaml"

    cli init repo --no-connect
    [ "$CLI_RC" -eq 0 ]
    [ "$(notice_count)" -eq 1 ]
    grep -qx '    k8s/env/configmap.yaml' "$SCRATCH/err"
    grep -qx '    k8s/env/component/kustomization.yaml' "$SCRATCH/err"
    refute grep -q 'external-secret.yaml' "$SCRATCH/err"
    grep -q 'Manifest will not update, compare or delete them' "$SCRATCH/err"
    grep -q 'examples/env-k8s-render.sh' "$SCRATCH/err"
    grep -q 'manifest status repo --env --json' "$SCRATCH/err"
    # The copy that ships with this tree is named by its real path.
    grep -qF "Installed copy: $TEST_REPO_ROOT/examples/env-k8s-render.sh" "$SCRATCH/err"
    [ -f "$TEST_REPO_ROOT/examples/env-k8s-render.sh" ]
    # stdout is the plan and nothing of the notice.
    refute grep -qF -- "$_NOTICE" "$SCRATCH/out"
    grep -q 'would create:    .env.example' "$SCRATCH/out"

    cli init repo --check
    [ "$CLI_RC" -eq 1 ]                        # .env.example is missing: the ordinary verdict
    [ "$(notice_count)" -eq 1 ]

    cli init repo --no-connect -y
    [ "$CLI_RC" -eq 0 ] || { cat "$SCRATCH/out" "$SCRATCH/err"; false; }
    [ "$(notice_count)" -eq 1 ]

    # --check runs the drift check inside itself with its output captured: its
    # own notice reaches stderr, exactly once, and none lands on stdout.
    git -C "$PROJ" add -A
    cli init repo --check
    [ "$CLI_RC" -eq 0 ] || { cat "$SCRATCH/out" "$SCRATCH/err"; false; }   # clean, notice or no notice
    [ "$(notice_count)" -eq 1 ]
    refute grep -qF -- "$_NOTICE" "$SCRATCH/out"
    grep -q 'env check: PASS' "$SCRATCH/out"

    # The files are as they were.
    [ "$(sed -n 2p "$PROJ/k8s/env/configmap.yaml")" = "kind: Whatever" ]
    [ "$(cat "$PROJ/k8s/env/external-secret.yaml")" = "$(printf 'apiVersion: v1\nkind: Secret')" ]
}

@test "a leftover env.secrets is named where it is set: the project config, the fleet root's, and the environment" {
    write_spec
    cat > "$PROJ/manifest.config.yaml" <<'YAML'
env:
  secrets:
    provider: none
YAML
    cli init repo --no-connect
    [ "$CLI_RC" -eq 0 ]
    [ "$(notice_count)" -eq 1 ]
    grep -qF "env.secrets in $PROJ/manifest.config.yaml" "$SCRATCH/err"
    grep -q 'These settings are no longer read. Remove them:' "$SCRATCH/err"
    # No file of Manifest's is there, so that half of the notice is absent.
    refute grep -q 'now yours to maintain' "$SCRATCH/err"

    # Set once at a fleet root, for a member that sets nothing itself.
    mkdir -p "$SCRATCH/fleet/acme.svc.ledger"
    local fleet member
    fleet="$(cd "$SCRATCH/fleet" && pwd -P)"
    member="$fleet/acme.svc.ledger"
    git -C "$member" init -q -b main
    : > "$fleet/manifest.fleet.config.yaml"
    cat > "$fleet/manifest.config.yaml" <<'YAML'
env:
  secrets:
    provider: external-secrets
    store:
      name: fleet-store
YAML
    write_spec "$member"
    cli_in "$member" init repo --no-connect
    [ "$CLI_RC" -eq 0 ]
    [ "$(notice_count)" -eq 1 ]
    grep -qF "env.secrets in $fleet/manifest.config.yaml" "$SCRATCH/err"

    # In the process environment.
    rm -f "$PROJ/manifest.config.yaml"
    export MANIFEST_CLI_ENV_SECRETS_STORE_NAME=team-store
    cli init repo --no-connect
    [ "$CLI_RC" -eq 0 ]
    [ "$(notice_count)" -eq 1 ]
    grep -qx '    MANIFEST_CLI_ENV_SECRETS_STORE_NAME (environment variable)' "$SCRATCH/err"
}

@test "a Dockerfile holding the ARG→ENV block an earlier Manifest wrote: told once, the block untouched, and a plain Dockerfile is told nothing (§127)" {
    write_spec
    printf 'FROM node:22 AS build\n# --- manifest env bridge (generated — edit the spec, not this block) ---\nARG OLD\nENV OLD=${OLD}\n# --- end manifest env bridge ---\nRUN npm run build\n' > "$PROJ/Dockerfile"
    chmod 644 "$PROJ/Dockerfile"
    local before
    before="$(cksum < "$PROJ/Dockerfile")"

    cli init repo --no-connect -y
    [ "$CLI_RC" -eq 0 ] || { cat "$SCRATCH/out" "$SCRATCH/err"; false; }
    [ "$(grep -cF 'Note: Manifest no longer writes or checks the ARG→ENV block in your Dockerfile.' "$SCRATCH/err" || true)" -eq 1 ]
    grep -q 'examples/env-dockerfile-render.sh' "$SCRATCH/err"
    grep -qF "Installed copy: $TEST_REPO_ROOT/examples/env-dockerfile-render.sh" "$SCRATCH/err"
    # Only the Dockerfile half: nothing of k8s/env is claimed.
    [ "$(notice_count)" -eq 0 ]
    [ "$(cksum < "$PROJ/Dockerfile")" = "$before" ]
    [ "$(manifest_file_mode "$PROJ/Dockerfile")" = "644" ]

    cli init repo --check
    [ "$(grep -cF 'ARG→ENV block in your Dockerfile' "$SCRATCH/err" || true)" -eq 1 ]

    # Control: the same Dockerfile without the block is told nothing.
    printf 'FROM node:22 AS build\nRUN npm run build\n' > "$PROJ/Dockerfile"
    cli init repo --check
    refute grep -qF 'ARG→ENV block' "$SCRATCH/err"
}

# --- and to no one else ------------------------------------------------------------------------

# Words that name a platform, a deployment tool, a secret store or a vendor.
_platform_pattern='k8s|kubernetes|kustomiz|configmap|externalsecret|external-secret|secretstore|helm|openbao|vault|hashicorp|aws|gcp|azure|doppler|1password|infisical|akeyless|bitwarden'

@test "a repo that never used the rendering: no notice, and nothing init, status --env or their help print names a platform or a vendor" {
    write_spec
    printf 'FROM scratch\n' > "$PROJ/Dockerfile"
    mkdir -p "$PROJ/k8s/base"
    printf 'kind: Deployment\n' > "$PROJ/k8s/base/deployment.yaml"   # their own k8s/, nothing of Manifest's

    : > "$SCRATCH/all"
    local -a cmd
    for cmd in "init repo --help" "status --help" "init repo --no-connect" "init repo --check" \
               "init repo --no-connect -y" "init repo --check" "status repo --env" "status repo --env --json"; do
        # shellcheck disable=SC2086
        cli $cmd
        [ "$(notice_count)" -eq 0 ] || { echo "notice printed by: $cmd"; cat "$SCRATCH/err"; false; }
        cat "$SCRATCH/out" "$SCRATCH/err" >> "$SCRATCH/all"
    done
    # Positive control: the commands ran and printed what they print.
    grep -q 'Wrote .env.example' "$SCRATCH/all"
    grep -q '"schema": 1' "$SCRATCH/all"

    # The project path is the test's own; everything else is the product's.
    local hits
    hits="$(sed "s#$PROJ##g" "$SCRATCH/all" | grep -ciE -- "$_platform_pattern" || true)"
    [ "$hits" -eq 0 ] || { sed "s#$PROJ##g" "$SCRATCH/all" | grep -iE -- "$_platform_pattern"; false; }
}

@test "positive control: the platform scan fires on the notice, and on a planted vendor string" {
    write_spec
    former_file k8s/env/configmap.yaml
    cli init repo --no-connect
    [ "$(grep -ciE -- "$_platform_pattern" "$SCRATCH/err" || true)" -ge 1 ]
    [ "$(printf 'name: openbao-customer\n' | grep -ciE -- "$_platform_pattern" || true)" -eq 1 ]
}

@test "the env module's own text names no vendor, and no secret-store kind outside the notice's file list" {
    local module="$TEST_REPO_ROOT/modules/core/manifest-env.sh"
    local vendors='openbao|vault|hashicorp|aws|gcp|azure|doppler|1password|infisical|akeyless|bitwarden'
    [ "$(grep -ciE -- "$vendors" "$module" || true)" -eq 0 ]
    # The example comment and its renderer, by function body.
    local init_env
    init_env="$(awk '/^_manifest_env_secret_example_comment\(\)/,/^}/; /^_manifest_env_render_example\(\)/,/^}/' \
        "$TEST_REPO_ROOT/modules/core/manifest-init.sh")"
    [ -n "$init_env" ]
    [ "$(printf '%s\n' "$init_env" | grep -ciE -- "$vendors|store kind|ClusterSecretStore|ExternalSecret" || true)" -eq 0 ]
    # The only lines of the module that name a deployment file are the four
    # former paths the notice recognises.
    [ "$(grep -ciE 'configmap|external-secret|kustomization' "$module")" -eq 4 ]
}
