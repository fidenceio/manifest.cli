#!/usr/bin/env bats

# Coverage for the env scaffold at init time (ensure_env_files /
# _manifest_env_prefix_for_repo). Pins: prefix derivation from the repo
# directory name under a configured env.prefix (and the neutral empty default);
# the spec paths — no spec → service.spec.yaml created (TRACKER §127), a spec
# without env: → a starter block added, `env: []` → left as written — and
# .env.example generated from the spec by the one writer; secret entries never
# emitted as live assignments; a hand-authored .env.example never replaced.

load 'helpers/setup'

setup() {
    load_modules
    SCRATCH="$(mk_scratch)"
    # Default policy: no explicit env.prefix, so the prefix is DERIVED from the
    # project name. Cases that need an explicit value or the disabled state set
    # MANIFEST_CLI_ENV_PREFIX themselves.
    unset MANIFEST_CLI_ENV_PREFIX
    # shellcheck disable=SC1091
    source "$TEST_REPO_ROOT/modules/core/manifest-init.sh"
}

teardown() {
    cd /tmp
    rm -rf "$SCRATCH"
    unset MANIFEST_CLI_ENV_PREFIX
}

mk_proj() {
    local name="$1"
    PROJ="$SCRATCH/$name"
    mkdir -p "$PROJ"
}

# --- prefix derivation ---------------------------------------------------------

@test "env prefix: fidence.app.kanizsa → FIDENCE_APP_KANIZSA_" {
    mk_proj "fidence.app.kanizsa"
    run _manifest_env_prefix_for_repo "$PROJ"
    [ "$output" = "FIDENCE_APP_KANIZSA_" ]
}

@test "env prefix: dots and hyphens map to underscores" {
    mk_proj "fidence.service.risk.fcra.microbilt-transunion"
    run _manifest_env_prefix_for_repo "$PROJ"
    [ "$output" = "FIDENCE_SERVICE_RISK_FCRA_MICROBILT_TRANSUNION_" ]
}

@test "env prefix: derived default is vendor-neutral (my-tool → MY_TOOL_)" {
    mk_proj "my-tool"
    run _manifest_env_prefix_for_repo "$PROJ"
    [ "$output" = "MY_TOOL_" ]
}

@test "env prefix: an explicit prefix overrides the derived default" {
    export MANIFEST_CLI_ENV_PREFIX="ACME_"
    mk_proj "acme.web"
    run _manifest_env_prefix_for_repo "$PROJ"
    [ "$output" = "ACME_WEB_" ]
}

@test "env prefix: env.prefix off → empty (policy disabled)" {
    export MANIFEST_CLI_ENV_PREFIX="off"
    mk_proj "fidence.app.demo"
    run _manifest_env_prefix_for_repo "$PROJ"
    [ "$output" = "" ]
}

# --- scaffold: no spec -----------------------------------------------------------

@test "env scaffold: no spec → service.spec.yaml is created, and .env.example is generated from it (§127)" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [[ "$output" == *"Created service.spec.yaml"* ]]
    [ "$(head -n 1 "$PROJ/service.spec.yaml")" = "# service.spec.yaml — created by Manifest CLI." ]
    # Manifest's only key: nothing else is invented for the spec.
    [ "$(yq e 'keys | join(",")' "$PROJ/service.spec.yaml")" = "env" ]
    [ "$(yq e '[.env[].name] | join(",")' "$PROJ/service.spec.yaml")" = "FIDENCE_APP_DEMO_LOG_LEVEL,FIDENCE_APP_DEMO_SERVICE_FQN" ]
    grep -q "generated by Manifest CLI from service.spec.yaml" "$PROJ/.env.example"
    grep -qx "FIDENCE_APP_DEMO_LOG_LEVEL=info" "$PROJ/.env.example"
}

@test "env scaffold: env.prefix off → the created spec's names carry no prefix" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    export MANIFEST_CLI_ENV_PREFIX="off"
    mk_proj "my-tool"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [ "$(yq e '.env[0].name' "$PROJ/service.spec.yaml")" = "LOG_LEVEL" ]
    grep -qx "LOG_LEVEL=info" "$PROJ/.env.example"
    refute grep -q "FIDENCE_" "$PROJ/.env.example"
}

@test "env scaffold: the starter SERVICE_FQN is the origin repository's name, not the folder's (§106)" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "checkout-of-billing"
    git -C "$PROJ" init -q
    git -C "$PROJ" remote add origin "git@github.com:acme/billing-service.git"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [ "$(yq e '.env[1].default' "$PROJ/service.spec.yaml")" = "billing-service" ]
}

@test "env scaffold: the plan says what -y does — spec, then .env.example — and writes nothing" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    run _manifest_init_env_plan "$PROJ"
    [ "$status" -eq 0 ]
    [[ "$output" == *"would create:    service.spec.yaml"* ]]
    [[ "$output" == *"would create:    .env.example"* ]]
    [ ! -e "$PROJ/service.spec.yaml" ]
    [ ! -e "$PROJ/.env.example" ]

    ensure_env_files "$PROJ" >/dev/null 2>&1
    run _manifest_init_env_plan "$PROJ"
    [[ "$output" == *"exists:          service.spec.yaml"* ]]
    [[ "$output" == *"exists:          .env.example   (up to date with the spec)"* ]]

    yq e -i '.env[0].default = "debug"' "$PROJ/service.spec.yaml"
    run _manifest_init_env_plan "$PROJ"
    [[ "$output" == *"would update:    .env.example"* ]]
}

@test "env scaffold: a hand-authored .env.example is never overwritten" {
    mk_proj "fidence.app.demo"
    printf '# mine\nCUSTOM=1\n' > "$PROJ/.env.example"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    grep -q "CUSTOM=1" "$PROJ/.env.example"
    refute grep -q "by Manifest CLI" "$PROJ/.env.example"
    [ ! -e "$PROJ/.env.example.manifest" ]
}

@test "env scaffold: a starter .env.example someone filled in is theirs — kept, whatever kind of line they added" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    local added before
    # One fixture per kind of line: live, commented NAME=, commented export,
    # commented with spaces round =, and a plain note.
    for added in 'DATABASE_URL=' '# STRIPE_KEY=' '# export STRIPE_SECRET_KEY=sk' '# DATABASE_URL = postgres://x' '# ask ops for the token'; do
        rm -f "$PROJ/.env.example" "$PROJ/service.spec.yaml"
        create_default_env_example "$PROJ/.env.example"
        printf '%s\n' "$added" >> "$PROJ/.env.example"
        before="$(cksum < "$PROJ/.env.example")"
        run ensure_env_files "$PROJ"
        [ "$status" -eq 0 ] || { echo "$added: exit $status"; return 1; }
        [[ "$output" == *"preserved"* ]] || { echo "$added: $output"; return 1; }
        [ "$(cksum < "$PROJ/.env.example")" = "$before" ] || { echo "$added: rewritten"; return 1; }
    done

    # Control: the starter init really writes, nothing added, is Manifest's —
    # with CRLF and trailing spaces, too — and is rewritten from the spec.
    rm -f "$PROJ/.env.example" "$PROJ/service.spec.yaml"
    create_default_env_example "$PROJ/.env.example"
    sed 's/$/  \r/' "$PROJ/.env.example" > "$PROJ/crlf" && mv "$PROJ/crlf" "$PROJ/.env.example"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [[ "$output" == *"Wrote .env.example"* ]]
    grep -qx "FIDENCE_APP_DEMO_LOG_LEVEL=info" "$PROJ/.env.example"
}

@test "env scaffold: a starter written under any env.prefix is still Manifest's — a prefix with - or . in it too" {
    source "$TEST_REPO_ROOT/modules/core/manifest-env.sh"
    mk_proj "web"
    # env.prefix is printed into the starter as given, checked nowhere: a
    # whitelist that knew only variable-name characters disowned these files.
    local prefix
    for prefix in 'ACME-' 'ACME.' 'acme' 'ACME_' 'off'; do
        export MANIFEST_CLI_ENV_PREFIX="$prefix"
        rm -f "$PROJ/.env.example"
        create_default_env_example "$PROJ/.env.example"
        run _manifest_env_starter_untouched "$PROJ/.env.example"
        [ "$status" -eq 0 ] || { echo "env.prefix $prefix: the starter is not recognised"; cat "$PROJ/.env.example"; return 1; }
    done
    # Control: under such a prefix a line of the user's still makes it theirs.
    export MANIFEST_CLI_ENV_PREFIX='ACME-'
    create_default_env_example "$PROJ/.env.example"
    printf '# export ACME-WEB_KEY=1\n' >> "$PROJ/.env.example"
    run _manifest_env_starter_untouched "$PROJ/.env.example"
    [ "$status" -eq 1 ]
}

@test "env scaffold: nothing is created through a dangling service.spec.yaml symlink, and the link is kept" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    mkdir -p "$SCRATCH/elsewhere"
    ln -s ../elsewhere/target.yaml "$PROJ/service.spec.yaml"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 1 ]
    [[ "$output" == *"not a readable file"* ]]
    [ ! -e "$SCRATCH/elsewhere/target.yaml" ]
    [ -L "$PROJ/service.spec.yaml" ]
    [ ! -e "$PROJ/.env.example" ]
    run _manifest_init_env_plan "$PROJ"
    [[ "$output" == *"cannot use:      service.spec.yaml is not a readable file"* ]]
}

@test "env scaffold: a .env.example that is not a readable file is never written through — the plan, -y and --check all stop on it, whatever the spec (§131)" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    source "$TEST_REPO_ROOT/modules/core/manifest-env.sh"
    mk_proj "fidence.app.demo"
    git -C "$PROJ" init -q -b main
    mkdir -p "$SCRATCH/outside" "$SCRATCH/shared"
    local spec example
    # Four specs with nothing to generate from — three take the starter path,
    # one has no spec yet — against three things that are not a readable file.
    for spec in empty-list shared no-env-key none; do
        for example in dangling directory unreadable; do
            # Root reads a mode-000 file, so there that state cannot be made.
            [ "$example" != "unreadable" ] || [ "$(id -u)" -ne 0 ] || continue
            rm -rf "$PROJ/.env.example" "$PROJ/service.spec.yaml" "$SCRATCH/outside/outside.env" "$SCRATCH/shared/spec.yaml"
            case "$spec" in
                empty-list) printf 'env: []\n' > "$PROJ/service.spec.yaml" ;;
                shared)     printf 'name: shared\n' > "$SCRATCH/shared/spec.yaml"
                            ln "$SCRATCH/shared/spec.yaml" "$PROJ/service.spec.yaml" ;;
                no-env-key) printf 'name: demo\n' > "$PROJ/service.spec.yaml" ;;
                none)       ;;
            esac
            case "$example" in
                dangling)   ln -s ../outside/outside.env "$PROJ/.env.example" ;;
                directory)  mkdir "$PROJ/.env.example" ;;
                unreadable) printf '# mine\n' > "$PROJ/.env.example"; chmod 000 "$PROJ/.env.example" ;;
            esac

            run _manifest_init_env_plan "$PROJ"
            [[ "$output" == *"cannot read:     .env.example   (not a readable file — -y stops here)"* ]] \
                || { echo "$spec/$example plan: $output"; return 1; }
            MANIFEST_CLI_PROJECT_ROOT="$PROJ" run manifest_env_validate
            [ "$status" -eq 1 ] || { echo "$spec/$example --check exit $status: $output"; return 1; }
            [[ "$output" == *"cannot read: .env.example (not a readable file)"* ]] \
                || { echo "$spec/$example --check: $output"; return 1; }
            run ensure_env_files "$PROJ"
            [ "$status" -eq 1 ] || { echo "$spec/$example -y exit $status: $output"; return 1; }
            # Nothing appeared at the far end of the link.
            [ ! -e "$SCRATCH/outside/outside.env" ] || { echo "$spec/$example: written through the link"; return 1; }
            [ "$example" != "unreadable" ] || chmod 644 "$PROJ/.env.example"
        done
    done

    # Control: the same spec with nothing in the way gets its starter.
    rm -rf "$PROJ/.env.example" "$PROJ/service.spec.yaml"
    printf 'env: []\n' > "$PROJ/service.spec.yaml"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [ -f "$PROJ/.env.example" ]
    MANIFEST_CLI_PROJECT_ROOT="$PROJ" run manifest_env_validate
    # env: [] is left as written, so --check must not say init will create one.
    [[ "$output" == *"the spec declares no variables (env: [])"* ]]
    [[ "$output" != *"creates one"* ]]
    [[ "$output" != *"cannot read: .env.example"* ]]
}

@test "env scaffold: a shared spec with no env: — symlink or hard link — is not seeded; init warns, writes the starter .env.example and goes on" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    source "$TEST_REPO_ROOT/modules/core/manifest-env.sh"
    mk_proj "fidence.app.demo"
    mkdir -p "$SCRATCH/shared"
    printf 'name: shared\n' > "$SCRATCH/shared/spec.yaml"
    ln -s ../shared/spec.yaml "$PROJ/service.spec.yaml"
    # The plan says both halves: the spec is left, the starter is created.
    run _manifest_init_env_plan "$PROJ"
    [[ "$output" == *"left:            service.spec.yaml is shared"* ]]
    [[ "$output" == *"would create:    .env.example   (the starter"* ]]
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [[ "$output" == *"is shared (a symlink or a hard link)"* ]]
    [ "$(cat "$SCRATCH/shared/spec.yaml")" = "name: shared" ]
    [ -L "$PROJ/service.spec.yaml" ]
    # The starter, so the scaffold is complete: returning without it made
    # `init repo -y` fail its readiness check on every run.
    [ "$(head -n 1 "$PROJ/.env.example")" = "# .env.example — scaffolded by Manifest CLI." ]
    # --check does not promise what -y will not do.
    MANIFEST_CLI_PROJECT_ROOT="$PROJ" run manifest_env_validate
    [[ "$output" == *"no spec env: block — service.spec.yaml is shared"*"Add an env: list to it yourself."* ]]
    [[ "$output" != *"creates one"* ]]
    [[ "$output" != *"the spec cannot be used"* ]]

    rm -f "$PROJ/service.spec.yaml" "$PROJ/.env.example"
    ln "$SCRATCH/shared/spec.yaml" "$PROJ/service.spec.yaml"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [[ "$output" == *"is shared"* ]]
    [ "$(cat "$SCRATCH/shared/spec.yaml")" = "name: shared" ]
    [ -f "$PROJ/.env.example" ]
    # A second run leaves the starter as it is: no-clobber.
    local before
    before="$(cksum < "$PROJ/.env.example")"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [ "$(cksum < "$PROJ/.env.example")" = "$before" ]

    # A read-only spec with no env: is left too, with its own reason. Root
    # can write a 444 file, so there it is writable, and that is not tested.
    [ "$(id -u)" -ne 0 ] || return 0
    rm -f "$PROJ/service.spec.yaml" "$PROJ/.env.example"
    printf 'name: demo\n' > "$PROJ/service.spec.yaml"
    chmod 444 "$PROJ/service.spec.yaml"
    run _manifest_init_env_plan "$PROJ"
    [[ "$output" == *"left:            service.spec.yaml is read-only"* ]]
    [[ "$output" == *"would create:    .env.example   (the starter"* ]]
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [[ "$output" == *"is read-only and has no env: key"* ]]
    [ "$(cat "$PROJ/service.spec.yaml")" = "name: demo" ]
    [ -f "$PROJ/.env.example" ]
    MANIFEST_CLI_PROJECT_ROOT="$PROJ" run manifest_env_validate
    [[ "$output" == *"no spec env: block — service.spec.yaml is read-only"*"Add an env: list to it yourself."* ]]
    [[ "$output" != *"creates one"* ]]
}

@test "env scaffold: init repo -y on a repository whose spec is shared leaves a complete scaffold, and --check passes it" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    git -C "$PROJ" init -q -b main
    mkdir -p "$SCRATCH/shared" "$SCRATCH/home"
    printf 'name: shared\n' > "$SCRATCH/shared/spec.yaml"
    ln "$SCRATCH/shared/spec.yaml" "$PROJ/service.spec.yaml"
    local cli="$TEST_REPO_ROOT/scripts/manifest-cli.sh"
    ( cd "$PROJ" && HOME="$SCRATCH/home" "$cli" init repo --no-connect -y ) > "$SCRATCH/out" 2>&1 \
        || { cat "$SCRATCH/out"; return 1; }
    # The predicate init's readiness check, guided init and fleet init all ask.
    manifest_repo_scaffold_is_complete "$PROJ"
    [ "$(cat "$SCRATCH/shared/spec.yaml")" = "name: shared" ]
    ( cd "$PROJ" && HOME="$SCRATCH/home" "$cli" init repo --check ) > "$SCRATCH/out" 2>&1 \
        || { cat "$SCRATCH/out"; return 1; }
    grep -qF 'Add an env: list to it yourself.' "$SCRATCH/out"
    refute grep -qF 'creates one' "$SCRATCH/out"
}

@test "env scaffold: a spec init cannot use stops -y, fails --check, and is named the same way in each" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    source "$TEST_REPO_ROOT/modules/core/manifest-env.sh"
    mk_proj "fidence.app.demo"
    git -C "$PROJ" init -q -b main
    local spec reason
    while IFS='|' read -r spec reason; do
        printf '%b' "$spec" > "$PROJ/service.spec.yaml"
        run ensure_env_files "$PROJ"
        [ "$status" -eq 1 ] || { echo "$reason: -y exit $status"; return 1; }
        [[ "$output" == *"$reason"* ]] || { echo "-y: $output"; return 1; }
        run _manifest_init_env_plan "$PROJ"
        [[ "$output" == *"cannot use:      "*"$reason"* ]] || { echo "plan: $output"; return 1; }
        MANIFEST_CLI_PROJECT_ROOT="$PROJ" run manifest_env_validate
        [ "$status" -eq 1 ] || { echo "$reason: --check exit $status"; return 1; }
        [[ "$output" == *"the spec cannot be used: "*"$reason"* ]] || { echo "check: $output"; return 1; }
    done <<'CASES'
env: [unclosed\n|cannot be parsed as YAML
a: 1\n---\nb: 2\n|holds more than one YAML document
- a\n- b\n|is not a map of keys
env: production\n|is not a list of variables
CASES
    # Control: a usable spec passes --check's drift part once -y has run.
    printf 'env: []\n' > "$PROJ/service.spec.yaml"
    MANIFEST_CLI_PROJECT_ROOT="$PROJ" run manifest_env_validate
    refute grep -q 'the spec cannot be used' <<<"$output"
}

@test "env scaffold: env: that is not a list stops the scaffold; a starter .env.example is not replaced" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    printf 'env: production\n' > "$PROJ/service.spec.yaml"
    printf '# .env.example — scaffolded by Manifest CLI.\n#\n' > "$PROJ/.env.example"
    local before
    before="$(cksum < "$PROJ/.env.example")"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 1 ]
    [[ "$output" == *"is not a list of variables"* ]]
    [ "$(cksum < "$PROJ/.env.example")" = "$before" ]
    [ "$(cat "$PROJ/service.spec.yaml")" = "env: production" ]
}

@test "env scaffold: seeding appends the block — the rest of the spec keeps its indentation and comments" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    printf 'name:    demo\nports:\n    - 80   # web\n' > "$PROJ/service.spec.yaml"
    chmod 640 "$PROJ/service.spec.yaml"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [ "$(sed -n 1p "$PROJ/service.spec.yaml")" = "name:    demo" ]
    [ "$(sed -n 3p "$PROJ/service.spec.yaml")" = "    - 80   # web" ]
    [ "$(yq e '.env | length' "$PROJ/service.spec.yaml")" = "2" ]
    local perms
    perms="$(ls -l "$PROJ/service.spec.yaml")"
    [ "${perms:0:10}" = "-rw-r-----" ]
}

@test "env scaffold: a spec write that fails part-way — a new spec is removed and nothing is left; an existing one keeps a whole copy, named" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    export TMPDIR="$SCRATCH/tmp"
    mkdir -p "$TMPDIR"
    # The final write of the spec fails after `>` has emptied it, as a full
    # disk does. Every other cat is the real one.
    cat() { case "$1" in */manifest-spec.*) return 1 ;; esac; command cat "$@"; }

    # A spec init was creating holds nothing of the user's: it is removed,
    # no "may now be incomplete" is printed about a file that is gone, and no
    # temporary file is left behind.
    run ensure_env_files "$PROJ"
    [ "$status" -eq 1 ]
    [[ "$output" == *"Could not create service.spec.yaml"* ]]
    [[ "$output" != *"may now be incomplete"* ]]
    [ ! -e "$PROJ/service.spec.yaml" ]
    [ -z "$(ls "$TMPDIR")" ]

    # A spec that was already there is the user's: the whole file, with the
    # env: block, is kept and named.
    printf '# mine\nname: demo\n' > "$PROJ/service.spec.yaml"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 1 ]
    [[ "$output" == *"service.spec.yaml; it may now be incomplete. The whole file, with the env: block, is at: "* ]]
    local kept="${output##*is at: }"
    kept="${kept%%$'\n'*}"
    [ -f "$kept" ]
    [ "$(head -n 2 "$kept")" = "$(printf '# mine\nname: demo')" ]
    [ "$(yq e '.env | length' "$kept")" = "2" ]
    unset -f cat
}

@test "env scaffold: a spec whose env: key is present but empty is still seeded (yq path)" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    printf 'name: demo\nenv:\n' > "$PROJ/service.spec.yaml"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [ "$(yq e '.env | length' "$PROJ/service.spec.yaml")" = "2" ]
    [ "$(yq e '.name' "$PROJ/service.spec.yaml")" = "demo" ]
}

@test "env scaffold: a .env.example Manifest wrote is brought up to date with the spec; it is not no-clobber" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    ensure_env_files "$PROJ" >/dev/null 2>&1
    yq e -i '.env[0].default = "debug"' "$PROJ/service.spec.yaml"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [[ "$output" == *"Wrote .env.example"* ]]
    grep -qx "FIDENCE_APP_DEMO_LOG_LEVEL=debug" "$PROJ/.env.example"
    # Control: run again and it is already current.
    run ensure_env_files "$PROJ"
    [[ "$output" == *".env.example up to date"* ]]
}

@test "env scaffold: a spec without env: is seeded even when .env.example already exists (§127)" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.service.demo"
    printf 'name: fidence.service.demo\n' > "$PROJ/service.spec.yaml"
    # The comment-only starter an earlier init wrote before the repo had a spec.
    printf '# .env.example — scaffolded by Manifest CLI.\n#\n' > "$PROJ/.env.example"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [ "$(yq e '.env | length' "$PROJ/service.spec.yaml")" = "2" ]
    grep -qx "FIDENCE_SERVICE_DEMO_LOG_LEVEL=info" "$PROJ/.env.example"
}

@test "env scaffold: env: [] is a decision — not seeded; a starter .env.example is written" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.service.demo"
    printf 'name: fidence.service.demo\nenv: []\n' > "$PROJ/service.spec.yaml"
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    [ "$(yq e '.env | length' "$PROJ/service.spec.yaml")" = "0" ]
    grep -q "scaffolded by Manifest CLI" "$PROJ/.env.example"
}

@test "env scaffold: a spec that is not valid YAML stops the scaffold and is not touched" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.service.demo"
    printf 'env: [\n  - :: broken\n' > "$PROJ/service.spec.yaml"
    local before
    before="$(cat "$PROJ/service.spec.yaml")"
    run ensure_env_files "$PROJ"
    [ "$status" -ne 0 ]
    [[ "$output" == *"cannot be parsed as YAML"* ]]
    [ "$(cat "$PROJ/service.spec.yaml")" = "$before" ]
    [ ! -e "$PROJ/.env.example" ]
}

# --- scaffold: spec with env: -----------------------------------------------------

@test "env scaffold: spec env: block generates the example (secrets commented)" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.app.demo"
    cat > "$PROJ/app.spec.yaml" <<'YAML'
name: fidence.app.demo
env:
  - name: FIDENCE_APP_DEMO_LOG_LEVEL
    description: Structured-log verbosity
    required: false
    default: info
    secret: false
  - name: FIDENCE_APP_DEMO_DB_PASSWORD
    description: Cockroach role password
    required: true
    secret: true
    group: db
    framework_name: DATABASE_URL
YAML

    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    grep -q "^FIDENCE_APP_DEMO_LOG_LEVEL=info$" "$PROJ/.env.example"
    # The secret is documented but never a live assignment.
    grep -q "^# FIDENCE_APP_DEMO_DB_PASSWORD=$" "$PROJ/.env.example"
    grep -qx "# secret — set from the platform's secret store; never a literal value in any .env" "$PROJ/.env.example"
    grep -q "DATABASE_URL" "$PROJ/.env.example"
    refute grep -q "^FIDENCE_APP_DEMO_DB_PASSWORD=" "$PROJ/.env.example"
    # No vendor is ever named for the reader to copy.
    refute grep -qi "openbao\|vault" "$PROJ/.env.example"

    # A leftover store setting changes nothing: no setting is read, so the
    # same spec renders the same file, and no store, path or kind reaches it.
    local first second
    first="$(cat "$PROJ/.env.example")"
    rm -f "$PROJ/.env.example"
    export MANIFEST_CLI_ENV_SECRETS_PROVIDER=external-secrets
    export MANIFEST_CLI_ENV_SECRETS_STORE_NAME=team-store
    export MANIFEST_CLI_ENV_SECRETS_PATH='kv/{env}/{identity}/{group}'
    export MANIFEST_CLI_ENV_SECRETS_ENV_LABEL=env
    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]
    second="$(cat "$PROJ/.env.example")"
    unset MANIFEST_CLI_ENV_SECRETS_PROVIDER MANIFEST_CLI_ENV_SECRETS_STORE_NAME \
          MANIFEST_CLI_ENV_SECRETS_PATH MANIFEST_CLI_ENV_SECRETS_ENV_LABEL
    [ "$first" = "$second" ]
    refute grep -q "team-store\|kv/" "$PROJ/.env.example"
}

# --- scaffold: spec without env: --------------------------------------------------

@test "env scaffold: spec without env: is seeded with a starter block first" {
    command -v yq >/dev/null 2>&1 || skip "yq not available"
    mk_proj "fidence.service.demo"
    printf 'name: fidence.service.demo\n' > "$PROJ/service.spec.yaml"

    run ensure_env_files "$PROJ"
    [ "$status" -eq 0 ]

    # The spec gained the starter env: block (source of truth, D-ENV-2)…
    [ "$(yq e '.env | length' "$PROJ/service.spec.yaml")" = "2" ]
    # Capture first, then match. Piping an external producer into `grep -q` is
    # unsafe under pipefail: grep exits at the first match, yq takes SIGPIPE, and
    # the pipeline reports 141 — a shell artifact, not a failed expectation. This
    # assertion flaked ~1 run in 8. The separate assignment keeps errexit catching
    # a yq failure, which a herestring would have masked.
    local env_names
    env_names="$(yq e '.env[].name' "$PROJ/service.spec.yaml")"
    grep -q "FIDENCE_SERVICE_DEMO_LOG_LEVEL" <<<"$env_names"
    grep -q "FIDENCE_SERVICE_DEMO_SERVICE_FQN" <<<"$env_names"

    # …and the example was generated from it.
    grep -q "^FIDENCE_SERVICE_DEMO_LOG_LEVEL=info$" "$PROJ/.env.example"
    grep -q "generated by Manifest CLI" "$PROJ/.env.example"
}
